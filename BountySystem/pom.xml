<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.bountysystem</groupId>
    <artifactId>bountysystem</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>BountySystem</name>
    <description>Produktionsreifes Bounty-Plugin fuer Paper mit Vault- und EternalEconomy-Unterstuetzung.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- PaperMC Repository fuer die Paper-API -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- JitPack Repository fuer die VaultAPI -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
            Paper-API, Stand: Minecraft 1.26.2 / Paper-Buildreihe 26.2.
            Offizielle Maven-Koordinaten laut docs.papermc.io/paper/dev/project-setup/.
            Der Versionsbereich [26.2.build,) loest automatisch den neuesten verfuegbaren
            26.2-Build auf. Fuer einen fest gepinnten Build kann stattdessen z.B.
            26.2.build.121-stable eingetragen werden.
        -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>[26.2.build,)</version>
            <scope>provided</scope>
        </dependency>

        <!--
            VaultAPI - offizielle Koordinaten laut github.com/MilkBowl/VaultAPI.
            Wird nur zur Kompilierzeit benoetigt (scope=provided), da das echte
            Vault-Plugin die Implementierung zur Laufzeit auf dem Server bereitstellt.
        -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>

        <resources>
            <!-- plugin.yml wird gefiltert, damit ${project.version} ersetzt wird -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <!-- alle anderen Ressourcen (z.B. config.yml) bleiben unveraendert -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <!-- Java 25 wird von Paper 26.2 vorausgesetzt (siehe docs.papermc.io) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>

            <!-- Baut die finale Plugin-JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
